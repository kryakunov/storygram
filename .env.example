# App
APP_ENV=development
NEXT_PUBLIC_APP_NAME=Сторис анонимно
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional search-console tokens
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=

# Postgres (docker compose)
DATABASE_URL=postgresql://storyviewer:storyviewer@localhost:5432/storyviewer

# Redis (optional — the app falls back to in-memory cache if unreachable)
REDIS_URL=redis://localhost:6379

# Provider: only `mock` is implemented. See src/providers/TODO.md.
STORY_PROVIDER=mock

# Used to hash request IPs before storage. Change in any shared environment.
IP_HASH_SALT=change-me-in-local-dev

# Rate limit: max requests per IP hash in the window
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Provider call timeout
PROVIDER_TIMEOUT_MS=5000

# Optional gate for /admin. Leave empty to keep admin open in local MVP.
ADMIN_TOKEN=
